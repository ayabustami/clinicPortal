{
  "name": "clinic-portal",
  "version": "1.0.0",
  "private": true,
  "description": "Multi-tenant Clinic Management Portal \u2014 MVP",
  "scripts": {
    "setup": "npm --prefix server install && npm --prefix client install",
    "migrate": "npm --prefix server run migrate",
    "seed": "npm --prefix server run seed",
    "seed:reset": "npm --prefix server run seed -- --reset",
    "dev:server": "npm --prefix server run dev",
    "dev:client": "npm --prefix client run dev",
    "test": "npm --prefix server test",
    "build": "npm --prefix client run build",
    "start": "npm --prefix server start",
    "email:check": "npm --prefix server run email:check"
  },
  "dependencies": {
    "nodemailer": "^10.1.7"
  }
}
