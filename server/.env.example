# Clinic Portal API — environment configuration
# Copy to .env and fill in real values. NEVER commit real secrets.
# (.env is git-ignored; .env.example must only ever contain placeholders.)

# Server
PORT=4000
NODE_ENV=development

# Security — REQUIRED in production: the server refuses to start with a weak
# or default secret. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

# Access token / session cookie lifetime (default 12h)
TOKEN_TTL=12h

# ---------------------------------------------------------------------------
# PostgreSQL (Neon) — REQUIRED. There is no hardcoded fallback.
# Use the POOLED connection string from the Neon console:
#   postgresql://USER:PASSWORD@HOST-neon.pooler.region.aws.neon.tech/DBNAME?sslmode=require
# SSL is enabled automatically for *.neon.tech hosts or when sslmode=require
# is present (public CA certificate is verified). Override with PGSSLMODE
# (require | verify-full | disable) if needed.
# This value must stay SERVER-SIDE ONLY — never expose it to the client build
# (no VITE_ prefixed copy, never bundled into the SPA).
# ---------------------------------------------------------------------------
DATABASE_URL=postgresql://USER:PASSWORD@YOUR-NEON-HOST/DBNAME?sslmode=require

# Connection pool size (Neon free tier: keep modest, e.g. 10)
PG_POOL_MAX=10

# Legacy SQLite file location — used ONLY by the one-time import
# (scripts/import-sqlite.js) and backup (scripts/backup.js) helpers.
# The running application never reads it.
SQLITE_PATH=./data/clinic-portal.db

# Allowed browser origin(s) for CSRF/origin defense — comma-separated list.
# Same-origin requests (Sec-Fetch-Site) are always allowed; this covers
# deployments where the SPA is served from a different origin than the API.
CLIENT_ORIGIN=http://localhost:5173

# Auth cookie policy (defaults are safe; only touch these if you know why):
#   production  -> SameSite=Lax (CSRF-safe default)
#   development -> SameSite=None + Secure (so cross-site HTTPS preview iframes
#                  keep the session; localhost counts as a secure origin)
# COOKIE_SAMESITE=lax
# COOKIE_SECURE=true

# Safety: `npm run seed` refuses to run when NODE_ENV=production unless this
# is explicitly set to YES (demo data must never reach a production database).
# ALLOW_DESTRUCTIVE_SEED=YES


# ---------------------------------------------------------------------------
# File storage for attachments (default: local filesystem under data/uploads)
# Set STORAGE_DRIVER=s3 to use S3 or any S3-compatible service (R2, MinIO).
# ---------------------------------------------------------------------------
# STORAGE_DRIVER=local
# S3_BUCKET=
# S3_REGION=us-east-1
# S3_ENDPOINT=
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# S3_FORCE_PATH_STYLE=false
